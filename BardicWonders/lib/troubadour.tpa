COPY ~%MOD_FOLDER%/troubadour/c0trbso.spl~ ~override~
  LPF ALTER_EFFECT
    INT_VAR
      timing = 10
	  duration = 100
	  power = 0
	  savingthrow = 0
  END
COPY ~%MOD_FOLDER%/troubadour/c0trbso2.spl~ ~override~
  LPF ALTER_EFFECT
    INT_VAR
      timing = 10
	  duration = 100
	  power = 0
	  savingthrow = 0
  END
COPY ~%MOD_FOLDER%/troubadour/C0TRBINB.bam~ ~override~
COPY ~%MOD_FOLDER%/troubadour/c0trbin.spl~ ~override~
SAY NAME1 ~和平之声~
SAY NAME2 ~和平之声~
SAY UNIDENTIFIED_DESC ~和平之声
行吟诗人吟唱柔和旋律，抚慰 <PRO_HISHER> 盟友的心神、重燃其信心，治愈 1d6（每级 +1）点生命值。受影响的所有盟友还获得 10% 物理抗性，并一回合内免疫狂暴效果。但在宁静光环生效期间，盟友中的野蛮人与狂战士将无法发动狂暴。~

COPY ~%MOD_FOLDER%/troubadour/c0trbin2.spl~ ~override~
SAY NAME1 ~神圣气息~
SAY NAME2 ~神圣气息~
SAY UNIDENTIFIED_DESC ~神圣气息
此能力效果与 5 级牧师法术死者复生相同，将目标复活。~

COPY_EXISTING ~SPPR103.spl~ ~override/C0TRBS1.spl~
WRITE_SHORT 0x1C 1
WRITE_LONG 0x34 1
COPY_EXISTING ~SPPR201.spl~ ~override/C0TRBS2.spl~
WRITE_SHORT 0x1C 1
WRITE_LONG 0x34 2
COPY_EXISTING ~SPPR315.spl~ ~override/C0TRBS3.spl~
WRITE_SHORT 0x1C 1
WRITE_LONG 0x34 3
COPY_EXISTING ~SPPR401.spl~ ~override/C0TRBS4.spl~
WRITE_SHORT 0x1C 1
WRITE_LONG 0x34 4
COPY_EXISTING ~SPPR514.spl~ ~override/C0TRBS5.spl~
WRITE_SHORT 0x1C 1
WRITE_LONG 0x34 5
COPY_EXISTING ~SPPR607.spl~ ~override/C0TRBS6.spl~
WRITE_SHORT 0x1C 1
WRITE_LONG 0x34 6

COPY ~%MOD_FOLDER%/troubadour/c0trbhl.spl~ ~override~
SAY NAME1 ~埃达丝圣咏~
SAY NAME2 ~埃达丝圣咏~
SAY UNIDENTIFIED_DESC ~埃达丝圣咏
这首歌对行吟诗人及其 <PRO_HISHER> 盟友都是强力助力。埃达丝圣咏使所有受者每轮再生 5 点生命值，并免疫所有妨碍移动与影响心智的效果、毒素、疾病、等级吸取与即死效果。队伍还获得防御等级与豁免 +4，对抗邪恶生物再 +2。此外所有受者有 5% 几率被治愈总生命值的 40%。

此能力取代当前的诗人歌谣。~

ACTION_IF FILE_EXISTS_IN_GAME ~garric.cre~
THEN BEGIN
PRINT ~可选：将加瑞克改为行吟诗人？~

PRINT ~请选择下列一项：
[1] 是
[2] 否~

OUTER_SPRINT ~kit~ ~placeholder_value~
OUTER_WHILE (!(IS_AN_INT ~kit~) OR (~kit~ > 0x2) OR (~kit~ < 0x1)) BEGIN
  PRINT ~请选择 1 或 2，然后按回车。~
  ACTION_READLN ~kit~
END
      ACTION_IF ("kit" = 1) THEN BEGIN
    COPY_EXISTING_REGEXP ~garric.*.cre~ ~override~
		WRITE_SHORT 0x246 (IDS_OF_SYMBOL (~kit~ ~C0TRB~))
      END
      ACTION_IF ("kit" = 2) THEN BEGIN
      END
      END
