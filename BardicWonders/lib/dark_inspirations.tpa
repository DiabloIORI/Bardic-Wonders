      INT_VAR
	    match_opcode = 139
		parameter1 = RESOLVE_STR_REF (~已习得激励贪噬：盟友攻击吸取生命值~ [GAM_11])
      END

COPY_EXISTING ~C0BDIT1.SPL~ ~OVERRIDE/C0BDIS4.SPL~
