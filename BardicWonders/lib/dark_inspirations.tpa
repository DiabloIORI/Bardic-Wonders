// NIGHTSINGER - DARK INSPIRATIONS

ACTION_IF FILE_EXISTS_IN_GAME ~C0SABARD.2DA~ BEGIN
COPY ~BardicWonders/inspirations/nightsinger~ OVERRIDE
COPY_EXISTING ~C0SABARD.2DA~ OVERRIDE
  LPF set_clab_2da_entries INT_VAR f_MinLevel = 1 f_MaxLevel = 1 STR_VAR f_Entry = GA_C0BDS00 END // Inspirations
  LPF set_clab_2da_entries INT_VAR f_MinLevel = 3 f_MaxLevel = 3 STR_VAR f_Entry = AP_C0BDST1 END // Inspirations
  LPF set_clab_2da_entries INT_VAR f_MinLevel = 6 f_MaxLevel = 6 STR_VAR f_Entry = AP_C0BDST2 END // Inspirations
  LPF set_clab_2da_entries INT_VAR f_MinLevel = 10 f_MaxLevel = 10 STR_VAR f_Entry = AP_C0BDST3 END // Inspirations
  LPF set_clab_2da_entries INT_VAR f_MinLevel = 12 f_MaxLevel = 12 STR_VAR f_Entry = AP_C0BDST4 END // Inspirations
  LPF set_clab_2da_entries INT_VAR f_MinLevel = 20 f_MaxLevel = 20 STR_VAR f_Entry = AP_C0BDST5 END // Inspirations

COPY_EXISTING C0BDS00.SPL OVERRIDE
SAY NAME1 ~黑暗感召~
SAY UNIDENTIFIED_DESC ~夜歌者的存在感召同伴，提供多种加成，只要同伴处于夜歌者视觉范围内即持续生效。同一时间只能激活一种感召。

激励暴怒（1 级）：盟友最低伤害检定 +2，但护甲等级 -1。8 级时加成与惩罚提升至 +3/-1，15 级 +4/-2，22 级 +5/-2。

激励雄心（3 级）：盟友施法等级 +1，法术持续时间 +10%。10 级时分别提升至 +2 与 +20%，17 级 +3 与 +30%。

激励护佑（6 级）：盟友魔法抗性 +2%。11 级提升至 +5%，16 级 +7%，21 级 +10%。

激励贪噬（10 级）：盟友攻击从目标吸取 1 点生命值。18 级吸取量增至 2 点，26 级 3 点。

激励胆识（12 级）：盟友背刺与暴击修正 +1。36 级提升至 +2。

激励统御（20 级）：盟友所有来源伤害 +15%。40 级提升至 +25%。~

LAF cd_new_portrait_icon INT_VAR string = RESOLVE_STR_REF(~激励暴怒~) STR_VAR bam_file = C0BDS0IA RET C0BDS0IA = icon END
LAF cd_new_portrait_icon INT_VAR string = RESOLVE_STR_REF(~激励雄心~) STR_VAR bam_file = C0BDS0IB RET C0BDS0IB = icon END
LAF cd_new_portrait_icon INT_VAR string = RESOLVE_STR_REF(~激励护佑~) STR_VAR bam_file = C0BDS0IC RET C0BDS0IC = icon END
LAF cd_new_portrait_icon INT_VAR string = RESOLVE_STR_REF(~激励贪噬~) STR_VAR bam_file = C0BDS0ID RET C0BDS0ID = icon END
LAF cd_new_portrait_icon INT_VAR string = RESOLVE_STR_REF(~激励胆识~) STR_VAR bam_file = C0BDS0IE RET C0BDS0IE = icon END
LAF cd_new_portrait_icon INT_VAR string = RESOLVE_STR_REF(~激励统御~) STR_VAR bam_file = C0BDS0IF RET C0BDS0IF = icon END

COPY_EXISTING ~C0BDIT1.SPL~ ~OVERRIDE/C0BDIS1.SPL~
      LPF ALTER_EFFECT
      INT_VAR
	    match_opcode = 139
		parameter1 = RESOLVE_STR_REF (~已习得激励雄心：盟友获得施法等级与法术持续时间加成~ [GAM_11])
      END

