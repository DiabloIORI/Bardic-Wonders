      INT_VAR
	    match_opcode = 139
		parameter1 = RESOLVE_STR_REF (~已习得激励胆识：盟友获得背刺与暴击修正加成~ [GAM_11])
      END

COPY_EXISTING ~C0BDIT1.SPL~ ~OVERRIDE/C0BDIS5.SPL~
      LPF ALTER_EFFECT
      INT_VAR
	    match_opcode = 139
		parameter1 = RESOLVE_STR_REF (~已习得激励统御：盟友所有伤害获得百分比加成~ [GAM_11])
      END

