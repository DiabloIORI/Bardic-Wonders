	// Fighter/Mage/Cleric = 17
	// Cleric/Ranger = 18
	// Sorcerer = 19
	// Monk = 20
	// Shaman = 21
    kit_class     = 5
	
    mixed         = RESOLVE_STR_REF(~面具侍从~)
	
    lower         = RESOLVE_STR_REF(~面具侍从~)
	
    help          = RESOLVE_STR_REF(~面具侍从：与普遍的看法不同，诡诈之神面具的眷顾并不只属于潜行与诡计之道。侍从是虔诚的面具信徒，影主的诡诈代理人，其胆识要通过那些让寻常诗人因性质黑暗而却步的考验来锤炼。

优势：

– 每级扒窃 +5%。
– 背刺倍率 x2。
– 侍从的歌谣“一家之失，另一家之得”为队伍提供偷窃与潜行加成。歌谣赋予所有偷窃技能 +15%，每头衔再 +5%，并带来下列效果：
	3 级：队员被动侦测陷阱
	6 级：队员获得模糊术（护甲等级 +3，所有豁免 +1）
	9 级：歌者有 50% 几率获得改善隐身，持续一轮
	12 级：队员获得反侦测
	15 级：歌者有 100% 几率获得改善隐身，持续一轮

– 10 级起，侍从受击时有 1% 几率被动隐身一回合。
– 12 级起，获得一次“暗影步”使用次数。

暗影步：角色踏入暗影位面，可在他人时间凝滞时移动 7 秒。在暗影位面中无法攻击或施法。

– 24 级时可习得“刺杀”高阶能力。

劣势：
– 阵营必须为绝对中立、混乱中立、中立邪恶或混乱邪恶。
– 学识值仅为常人一半。
– 不得习得“魔法长笛”高阶能力。
– 只能熟练使用盗贼可用的武器。~)
	
    briefdesc     = RESOLVE_STR_REF(~面具侍从：与普遍的看法不同，诡诈之神面具的眷顾并不只属于潜行与诡计之道。侍从是虔诚的面具信徒，影主的诡诈代理人，其胆识要通过那些让寻常诗人因性质黑暗而却步的考验来锤炼。~)
	
	// fallen = 0
	
  STR_VAR
    kit_name      = ~C0ABETT~
	
    unusable      = ~0x00004000~
    // clasweap      = ~1 1 1 1 1 1 1 1~
