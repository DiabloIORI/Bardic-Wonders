COPY ~%MOD_FOLDER%/Inspirations~ ~OVERRIDE~

ADD_PROJECTILE ~%MOD_FOLDER%/inspirations/c0bdipr.PRO~ ~C0 Inspiration~

ACTION_IF FILE_EXISTS_IN_GAME ~CLABBA01.2DA~ BEGIN
COPY_EXISTING ~CLABBA01.2DA~ OVERRIDE
  LPF set_clab_2da_entries INT_VAR f_MinLevel = 1 f_MaxLevel = 1 STR_VAR f_Entry = GA_C0BDI00 END // Inspirations
  LPF set_clab_2da_entries INT_VAR f_MinLevel = 3 f_MaxLevel = 3 STR_VAR f_Entry = AP_C0BDIT1 END // Inspirations
  LPF set_clab_2da_entries INT_VAR f_MinLevel = 6 f_MaxLevel = 6 STR_VAR f_Entry = AP_C0BDIT2 END // Inspirations
  LPF set_clab_2da_entries INT_VAR f_MinLevel = 10 f_MaxLevel = 10 STR_VAR f_Entry = AP_C0BDIT3 END // Inspirations
  LPF set_clab_2da_entries INT_VAR f_MinLevel = 12 f_MaxLevel = 12 STR_VAR f_Entry = AP_C0BDIT4 END // Inspirations
  LPF set_clab_2da_entries INT_VAR f_MinLevel = 20 f_MaxLevel = 20 STR_VAR f_Entry = AP_C0BDIT5 END // Inspirations
END

DEFINE_ACTION_FUNCTION cd_new_portrait_icon
  INT_VAR string = 0
  STR_VAR bam_file = "****"
  RET     icon
  BEGIN

  COPY_EXISTING ~statdesc.2da~ ~override~
    COUNT_2DA_ROWS 3 count
    READ_2DA_ENTRY (count - 1) 0 3 icon
    SET icon += 1

  APPEND ~statdesc.2da~ ~%icon% %string% %bam_file%~ UNLESS ~%bam_file%~

END

///////////////////////////////////////////////////////////////////////////
// Update Kit Descriptions                                               //
///////////////////////////////////////////////////////////////////////////
ACTION_FOR_EACH description IN 
    clastext  
  BEGIN
    ACTION_IF FILE_EXISTS_IN_GAME ~%description%.2da~ BEGIN
      COPY_EXISTING ~%description%.2DA~ ~override~
      COUNT_2DA_COLS col_count
      COUNT_2DA_ROWS col_count rows
      FOR (index = 0; index < rows; ++index) BEGIN
        READ_2DA_ENTRY index 0 col_count row_name
        READ_2DA_ENTRY index 1 col_count class_id
//bard

        PATCH_IF "%row_name%" STRING_EQUAL_CASE "BARD" BEGIN
          READ_2DA_ENTRY index 4 col_count kit_desc
          SPRINT old_desc ~– May use Bard Song ability~
          SPRINT new_desc ~– 可使用诗人感召。只要处于诗人视觉范围内，感召便持续提供多种加成。~
          GET_STRREF %kit_desc% desc_text
          INNER_PATCH_SAVE desc_text ~%desc_text%~ BEGIN
            REPLACE_TEXTUALLY ~%old_desc%~ ~%new_desc%
%old_desc%~
          END
          SET_2DA_ENTRY index 4 col_count RESOLVE_STR_REF (~%desc_text%~)
            PRETTY_PRINT_2DA
		END
		
//inspiration
        PATCH_IF ((class_id = 5) AND (
				!("%row_name%" STRING_EQUAL_CASE "C0SABARD")
														 )) 
                              BEGIN
          READ_2DA_ENTRY index 4 col_count kit_desc
          SPRINT old_inspiration ~劣势：~
          SPRINT new_inspiration ~– 无法使用感召。~
          SPRINT disadvantages_none ~
– 无。~
          GET_STRREF %kit_desc% desc_text
          INNER_PATCH_SAVE desc_text ~%desc_text%~ BEGIN
            REPLACE_TEXTUALLY ~%old_inspiration%~ ~%old_inspiration%
%new_inspiration%~
            REPLACE_TEXTUALLY ~%disadvantages_none%~ ~~
          END
            SET_2DA_ENTRY index 4 col_count RESOLVE_STR_REF (~%desc_text%~)
            PRETTY_PRINT_2DA
		END

      END

      COPY_EXISTING ~KITLIST.2DA~ ~override~
      COUNT_2DA_COLS col_count
      COUNT_2DA_ROWS col_count rows
      FOR (index = 1; index < rows; ++index) BEGIN
        READ_2DA_ENTRY index 1 col_count row_name
        READ_2DA_ENTRY index 8 col_count class_id
//inspiration
        PATCH_IF ((class_id = 5) AND (
				!("%row_name%" STRING_EQUAL_CASE "BARD")
														 )) 
                              BEGIN
          READ_2DA_ENTRY index 4 col_count kit_desc
          GET_STRREF %kit_desc% desc_text
          INNER_PATCH_SAVE desc_text ~%desc_text%~ BEGIN
            REPLACE_TEXTUALLY ~%old_inspiration%~ ~%old_inspiration%
%new_inspiration%~
            REPLACE_TEXTUALLY ~%disadvantages_none%~ ~~
          END
          SET_2DA_ENTRY index 4 col_count RESOLVE_STR_REF (~%desc_text%~)
            PRETTY_PRINT_2DA
		      END
		  END

      BUT_ONLY
    END
  END
  
LAF cd_new_portrait_icon INT_VAR string = RESOLVE_STR_REF(~激励勇气~) STR_VAR bam_file = C0BDI0IA RET C0BDI0IA = icon END
LAF cd_new_portrait_icon INT_VAR string = RESOLVE_STR_REF(~激励干练~) STR_VAR bam_file = C0BDI0IB RET C0BDI0IB = icon END
LAF cd_new_portrait_icon INT_VAR string = RESOLVE_STR_REF(~激励防御~) STR_VAR bam_file = C0BDI0IC RET C0BDI0IC = icon END
LAF cd_new_portrait_icon INT_VAR string = RESOLVE_STR_REF(~激励再生~) STR_VAR bam_file = C0BDI0ID RET C0BDI0ID = icon END
LAF cd_new_portrait_icon INT_VAR string = RESOLVE_STR_REF(~激励坚韧~) STR_VAR bam_file = C0BDI0IE RET C0BDI0IE = icon END
LAF cd_new_portrait_icon INT_VAR string = RESOLVE_STR_REF(~激励迅捷~) STR_VAR bam_file = C0BDI0IF RET C0BDI0IF = icon END

COPY_EXISTING C0BDI00.SPL OVERRIDE
SAY NAME1 ~诗人感召~
SAY UNIDENTIFIED_DESC ~诗人的存在感召同伴，提供多种加成，只要同伴处于诗人视觉范围内即持续生效。同一时间只能激活一种感召。

激励勇气（1 级）：盟友命中检定 +1，士气提升。命中加成 8 级时增至 +2，15 级 +3，22 级 +4。

激励干练（3 级）：盟友学识与偷窃技能 +10。10 级增至 +20，17 级 +30。

激励防御（6 级）：盟友对抗所有武器类型护甲等级 +2。14 级增至 +3，22 级 +4。

激励再生（10 级）：盟友每 2 轮再生 1 点生命值。18 级增至 2 点，26 级 3 点。

激励坚韧（12 级）：盟友所有豁免 +2。21 级增至 +3，30 级 +4。

激励迅捷（20 级）：盟友施法速度 +1。40 级施法速度加成增至 +2。~

COPY_EXISTING C0BDIT1.SPL OVERRIDE
      LPF ALTER_EFFECT
      INT_VAR
	    match_opcode = 139
		parameter1 = RESOLVE_STR_REF (~已习得激励干练：盟友获得学识与所有偷窃技能加成~ [GAM_11])
      END

COPY_EXISTING ~C0BDIT1.SPL~ ~OVERRIDE/C0BDIT2.SPL~
      LPF ALTER_EFFECT
      INT_VAR
	    match_opcode = 139
		parameter1 = RESOLVE_STR_REF (~已习得激励防御：盟友获得护甲等级加成~ [GAM_11])
      END

COPY_EXISTING ~C0BDIT1.SPL~ ~OVERRIDE/C0BDIT3.SPL~
      LPF ALTER_EFFECT
      INT_VAR
	    match_opcode = 139
		parameter1 = RESOLVE_STR_REF (~已习得激励再生：盟友再生生命值~ [GAM_11])
      END

COPY_EXISTING ~C0BDIT1.SPL~ ~OVERRIDE/C0BDIT4.SPL~
      LPF ALTER_EFFECT
      INT_VAR
	    match_opcode = 139
		parameter1 = RESOLVE_STR_REF (~已习得激励坚韧：盟友获得豁免加成~ [GAM_11])
      END

COPY_EXISTING ~C0BDIT1.SPL~ ~OVERRIDE/C0BDIT5.SPL~
      LPF ALTER_EFFECT
      INT_VAR
	    match_opcode = 139
		parameter1 = RESOLVE_STR_REF (~已习得激励迅捷：盟友获得施法速度加成~ [GAM_11])
      END

