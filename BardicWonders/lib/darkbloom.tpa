COPY ~%MOD_FOLDER%/darkbloom/BGEE/SPPR427C.BAM~ ~override~
COPY ~%MOD_FOLDER%/darkbloom/BGEE/tsprayt.BAM~ ~override~
ADD_PROJECTILE ~%MOD_FOLDER%/darkbloom/BGEE/idpro303.PRO~ ~Thorn Spray~
