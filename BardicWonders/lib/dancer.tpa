//////////// DANCER

COPY ~%MOD_FOLDER%/dancer~ ~override~

COPY_EXISTING ~LUBA0.2DA~ ~OVERRIDE/LUC0DANC.2DA~
  REPLACE_TEXTUALLY ~AP_SPCL920~ ~AP_C0DANCHL~

LAF ADD_KIT_EX
  INT_VAR
    // Mage	= 1
	// Fighter = 2
	// Cleric = 3
	// Thief = 4
	// Bard = 5
	// Paladin = 6
	// Fighter/Mage = 7
	// Fighter/Cleric = 8
	// Fighter/Thief = 9
	// Fighter/Mage/Thief = 10
	// Druid = 11
	// Ranger = 12
	// Mage/Thief = 13
	// Cleric/Mage = 14
	// Cleric/Thief = 15
	// Fighter/Druid = 16
	// Fighter/Mage/Cleric = 17
	// Cleric/Ranger = 18
	// Sorcerer = 19
	// Monk = 20
	// Shaman = 21
    kit_class     = 5
	
    mixed         = RESOLVE_STR_REF(~舞者~)
	
    lower         = RESOLVE_STR_REF(~舞者~)
	
    help          = RESOLVE_STR_REF(~舞者：舞者既是表演者、杂技演员，一旦投入战斗又是出人意料的危险斗士，以速度与灵巧迷惑、震慑 <PRO_HISHER> 对手，同时激励盟友更有信心地作战。

优势：
– 双武器风格可投入 3 个熟练度点。
– 1 级基础防御等级 +2。10 级时再 +1，此后每 10 级再 +1。
– 1 级对抗远程武器防御等级 +1。此后每 5 级防御等级再 +1。
– 移动速率 +2。
– 舞者的诗人歌谣“浮莲之舞”在激励 <PRO_HISHER> 盟友的同时定住舞者自身，赋予对恐惧与士气崩溃的免疫，并提供下列加成：
	1 级：命中与伤害 +1，每回合 1/2 次额外攻击，舞者防御等级 +2
	6 级：命中与伤害 +2，每回合 1/2 次额外攻击，舞者防御等级 +4
	11 级：命中与伤害 +3，每回合 1/2 次额外攻击，舞者防御等级 +6
	16 级：命中与伤害 +4，每回合 1 次额外攻击，舞者防御等级 +8
	21 级：命中与伤害 +5，每回合 1 次额外攻击，舞者防御等级 +10

– 4 级起，每日可使用一次“肾上腺素迸发”。8 级与 12 级各增加一次使用次数。

肾上腺素迸发：舞者在 3 轮内暂时获得巨大力量提升，每 4 级命中与伤害 +1。每轮攻击次数也翻倍。但 <PRO_HISHER> 防御等级降低 4 点，<PRO_HESHE> 无法使用 <PRO_HISHER> 诗人歌谣；持续结束后，<PRO_HESHE> 脱力，疲劳受到重罚，且一回合内无法使用 <PRO_HISHER> 诗人歌谣。18 级起，效果结束后舞者不再疲劳。

劣势：
– 不得穿戴任何护甲。
– 不得使用盾牌。
– 每级可记忆的法术少一个。
– 学识值仅为常人一半。~)
	
    briefdesc     = RESOLVE_STR_REF(~舞者：舞者既是表演者、杂技演员，一旦投入战斗又是出人意料的危险斗士，以速度与灵巧迷惑、震慑对手，同时激励盟友更有信心地作战。~)
	
	// fallen = 0
	
  STR_VAR
